# Copy this file to .env and fill in real values. Never commit .env.

# Local dev (docker-compose): postgresql://mmotors:mmotors@db:5432/mmotors
# Azure prod: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/mmotors?sslmode=require
DATABASE_URL=postgresql://mmotors:mmotors@localhost:5432/mmotors

SECRET_KEY=change-me-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
